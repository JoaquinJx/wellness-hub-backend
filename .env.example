# ─────────────────────────────────────────────────────────────
# Wellness Hub — Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Local development (SQLite):
# DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL — obtener de Neon.tech):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wellness_hub?sslmode=require"

# ── JWT ───────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_generate_a_64_char_random_string"
JWT_EXPIRES_IN="60m"
JWT_REFRESH_SECRET="CHANGE_ME_different_64_char_random_string"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ────────────────────────────────────────────────────
PORT=3000

# Producción: URL de tu frontend en Vercel
CORS_ORIGIN="https://tu-app.vercel.app"
